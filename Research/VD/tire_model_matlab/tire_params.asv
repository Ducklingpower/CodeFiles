function p = tire_params(spec)
%TIRE_PARAMS  Tyre parameter set for the PAIRSim combined-slip tyre model.
%
%   p = TIRE_PARAMS('front')  default front-axle params
%   p = TIRE_PARAMS('rear')   default rear-axle params
%   p = TIRE_PARAMS(jsonFile) load from a PAIRSIM_config JSON, e.g.
%       tire_params('~/PAIRSIM_config/Parameters/FrontAxleTireParams.json')
%
%   The defaults mirror defaultFrontAxleParams / defaultRearAxleParams in
%   Assets/Autonoma/Scripts/VehicleDynamics/WheelController.cs:348-409.
%   Note that at runtime the sim ALWAYS overwrites the ScriptableObject with
%   ~/PAIRSIM_config/Parameters/{Front,Rear}AxleTireParams.json
%   (WheelController.Start, WheelController.cs:246) -- so if you have tuned
%   the car on this machine, load those files rather than the defaults.
%
%   Fields used by tire_forces():
%     FzNom     [N]    nominal vertical load (load-sensitivity reference)
%     Dy,Dy2    [-]    peak lateral friction and its load sensitivity
%     Cy        [-]    lateral shape factor
%     syPeak    [rad]  slip angle at peak Fy (sets stiffness factor By)
%     Dx,Dx2,Cx,sxPeak  same, longitudinal (sxPeak is a slip ratio [-])
%   Fields used elsewhere in the sim (kept for completeness):
%     relaxLenY/X, rollResForce, wheelInertia, tyreRadius,
%     p1..p7, mT, cT, hT, ACp, thermalFrictionMap*

if nargin < 1 || isempty(spec)
    spec = 'front';
end

switch lower(spec)
    case 'front'
        p = struct( ...
            'name',        'front (default)', ...
            'FzNom',       1680, ...
            'Dy',          1.5, ...
            'Dy2',        -0.1, ...
            'Cy',          1.2, ...
            'syPeak',      0.078539, ...
            'relaxLenY',   0.1, ...
            'Dx',          1.3, ...
            'Dx2',          -0.1, ...
            'Cx',          1.2, ...
            'sxPeak',      0.03, ...
            'relaxLenX',   0.1, ...
            'rollResForce',60, ...
            'wheelInertia',2, ...
            'tyreRadius',  0.3);

    case 'rear'
        p = struct( ...
            'name',        'rear (default)', ...
            'FzNom',       2318, ...
            'Dy',          1.55, ...
            'Dy2',        -0.1, ...
            'Cy',          1.2, ...
            'syPeak',      0.078525, ...
            'relaxLenY',   0.1, ...
            'Dx',          1.0, ...
            'Dx2',        -0.1, ...
            'Cx',          1.2, ...
            'sxPeak',      0.03, ...
            'relaxLenX',   0.1, ...
            'rollResForce',60, ...
            'wheelInertia',2, ...
            'tyreRadius',  0.31);

    otherwise
        % treat the argument as a path to a PAIRSIM_config tyre JSON
        f = spec;
        if ~isempty(f) && f(1) == '~'
            home = getenv('HOME');
            if isempty(home), home = getenv('USERPROFILE'); end
            f = fullfile(home, f(2:end));
        end
        if exist(f, 'file') ~= 2
            error('tire_params:badSpec', ...
                  'Unknown axle "%s" and no such file. Use ''front'', ''rear'' or a JSON path.', spec);
        end
        fid = fopen(f, 'r');
        raw = fread(fid, inf, '*char')';
        fclose(fid);
        p = jsondecode(raw);
        [~, base, ext] = fileparts(f);
        p.name = [base ext];
end

% --- thermal block: identical front/rear in every shipped config ---------
if ~isfield(p, 'p1')
    p.p1 = 0.001;   p.p2 = 0.0001;  p.p3 = 0.0001;  p.p4 = 0.00001;
    p.p5 = 0.001;   p.p6 = 1.2;     p.p7 = 0.0003;
    p.mT = 10;      p.cT = 3;       p.hT = 12;      p.ACp = 0.01;
    p.numPointsFrictionMap    = 5;
    p.thermalFrictionMapInput  = [0 30 70 100 130];   % degC
    p.thermalFrictionMapOutput = [0.8 0.9 1.0 1.0 0.8];
end

% --- knobs that live outside the tyre params in the sim ------------------
% useThermal mirrors GameManager.Instance.Settings.myVehSetup.IsThermalTyre
% (WheelController.calcThermalScaling, WheelController.cs:210)
if ~isfield(p, 'useThermal'), p.useThermal = false; end
if ~isfield(p, 'tAmb'),       p.tAmb       = 25;    end  % VehicleParameters.tAmb

p.thermalFrictionMapInput  = double(p.thermalFrictionMapInput(:)).';
p.thermalFrictionMapOutput = double(p.thermalFrictionMapOutput(:)).';
end
