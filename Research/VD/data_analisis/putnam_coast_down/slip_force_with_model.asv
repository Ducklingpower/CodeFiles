title('Front Right (modeled)');
cb = colorbar; ylabel(cb,'Time [s]'); xline(0,'k--'); yline(0,'k--');

subplot(2,2,3)
scatter(slip_ratio_x_rl(validRL), fx_rl_model(validRL), 18, t(validRL), 'filled');
grid on; xlabel('\kappa_{rl} [-]'); ylabel('F_{x,rl} [N]');
