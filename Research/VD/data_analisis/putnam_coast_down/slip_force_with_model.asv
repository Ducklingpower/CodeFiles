title('Rear Right (modeled)');
cb = colorbar; ylabel(cb,'Time [s]'); xline(0,'k--'); yline(0,'k--');

sgtitle('Figure 5: Longitudinal Force vs Slip Ratio (per tire, modeled F_x)');

