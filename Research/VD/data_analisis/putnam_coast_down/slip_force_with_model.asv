clc
close all
clear


%%
%data = readtable('/home/elijah/PurdueRacing/bags/putnam/oversteer/2026-04-28_150159_merged.csv');
data = readtable('/home/elijah/PurdueRacing/bags/lagoona/comp/csv_output/2025-07-24_175839_merged.csv');

tStart = 0;
tCut   = 1000;


% turn 11 final lab data
tStart = 820;
tCut = 826;



tRel = data.time_s - data.time_s(1);
data = data(tRel >= tStart & tRel <= tCut, :);

mm = 10;
vx_min_slip_angle = 2;
vx_min_slip_ratio = 0.001;

onlyAccelerating = false;

useBankCorrection = true;
pitchSign = -1;

% Steering calibration
steeringRatio = 15.015;
steeringBias_deg = 0.333;

% Tire rolling radii
Rw_f = 0.30;   % [m]
Rw_r = 0.31;   % [m]

wheelSpeedIsKmh = true;
brakePressureMin_kPa = 75;
defaultFrontBrakeBias = 0.53;

% Longitudinal force deadband
Fx_deadband_N = 50;

% Throttle threshold for "accelerating" (all drive Fx goes to rear axle)
throttleAccel_pct = 7;

%% =========================


vehicleParams.L       = 2.9718;   % [m] wheelbase
vehicleParams.wDistF  = 0.42;     % static front weight distribution
vehicleParams.m       = 815;      % [kg]
vehicleParams.Iz      = 1000;     % [kg m^2]
vehicleParams.hCG     = 0.275;    % [m]
vehicleParams.CdA     = 1.33;     % [m^2]
vehicleParams.rho     = 1.225;    % [kg/m^3]
vehicleParams.g       = 9.81;     % [m/s^2]

L  = vehicleParams.L;
m  = vehicleParams.m;
Iz = vehicleParams.Iz;
g  = vehicleParams.g;

% IMPORTANT:
% For a bicycle model:
% lf = CG to front axle
% lr = CG to rear axle
%
% Static front load fraction = lr / L
lr = vehicleParams.wDistF * L;    % CG to rear axle
lf = L - lr;                      % CG to front axle

front_track = 1.68;
rear_track = 1.52;

%% filtered signals


t = data.time_s(:);
t = t - t(1);

ax = movmean(data.a_x, mm);
ay_meas = movmean(data.a_y, mm);

vx = movmean(data.odom_vx_mps, mm);
vy = movmean(data.odom_vy_mps, mm);

r = movmean(data.odom_wz_rads, mm);   % yaw rate

% yaw acceleration
dt = gradient(t);
dt(dt <= 0) = median(dt(dt > 0));

rdot = gradient(r) ./ dt;
rdot = movmean(rdot, mm);

% Steering
steering_wheel_deg = movmean(data.steer_wheel_ang_deg, mm);
delta_deg = steeringBias_deg + steering_wheel_deg ./ steeringRatio;
delta = deg2rad(delta_deg);

% Brake pressures
Pf = movmean(data.front_brake_pressure_kpa, mm);
Pr = movmean(data.rear_brake_pressure_kpa, mm);
throttle_pct   = movmean(data.throttle_pct, mm);
cmd_throttle   = movmean(data.joy_accelerator_cmd,mm);
isAccelerating = throttle_pct > throttleAccel_pct;
isBraking      = (Pf > 1000) | (Pr > 1000);


if onlyAccelerating
    accelKeep = isAccelerating;
else
    accelKeep = true(size(ax));
end

% Position
x_pos = data.odom_px_m;
y_pos = data.odom_py_m;

% Distance traveled
V = sqrt(vx.^2 + vy.^2);
ds = [0; cumsum(0.5 .* (V(1:end-1) + V(2:end)) .* diff(t))];

%%
%  Pitch / Roll


qx = movmean(data.odom_qx, mm);
qy = movmean(data.odom_qy, mm);
qz = movmean(data.odom_qz, mm);
qw = movmean(data.odom_qw, mm);

q = [qw qx qy qz];
eul = quat2eul(q, 'ZYX');   % [yaw pitch roll]

pitch = eul(:,2);
roll  = eul(:,3);

theta = pitchSign .* pitch;
phi   = roll;

%% lat acel derived

kappa_yaw = nan(size(V));

validCurv = isfinite(V) & V > 2.0 & isfinite(r);
kappa_yaw(validCurv) = r(validCurv) ./ V(validCurv);

ay_inertial = V.^2 .* kappa_yaw;


g_y_body = -g .* cos(theta) .* sin(phi);

if useBankCorrection
    ay_tire = ay_inertial - g_y_body;
else
    ay_tire = ay_inertial;
end

ay_tire(~validCurv) = NaN;



%%
%  Normal Loads



Fz_front_offset_N = -4168.3223;
Fz_rear_offset_N  = -3885.9196;

Fz_fl = movmean(data.fl_load_n,mm);
Fz_fr = movmean(data.fr_load_n,mm);
Fz_rl = movmean(data.rl_load_n,mm);
Fz_rr = movmean(data.rr_load_n,mm);


Fz_front = Fz_fl + Fz_fr + Fz_front_offset_N;
Fz_rear  = Fz_rl + Fz_rr + Fz_rear_offset_N;


%%
%  Bicycle Model Slip Angles + lat force


vx_safe_angle = vx;
vx_safe_angle(abs(vx_safe_angle) < vx_min_slip_angle) = NaN;

vy_front = vy + lf .* r;
vy_rear  = vy - lr .* r;

alpha_f = delta - atan2(vy_front, vx_safe_angle);
alpha_r =       - atan2(vy_rear,  vx_safe_angle);

alpha_f_deg = rad2deg(alpha_f);
alpha_r_deg = rad2deg(alpha_r);



Fyf = (m .* lr .* ay_tire + Iz .* rdot) ./ L;
Fyr = (m .* lf .* ay_tire - Iz .* rdot) ./ L;

%% FX total (measured)
rho = vehicleParams.rho;
CdA = vehicleParams.CdA;

Fdrag = 0.5 .* rho .* CdA .* vx .* abs(vx);      % sign-aware drag compensation
Fgrade = m .* g .* sin(theta);                   % positive uphill

Fx_total = m .* ax + Fdrag + Fgrade + Fyf.*sin(delta);

%% =========================================================================
%  ENGINE-MAP TIRE FORCE MODEL  (transplanted from estimate_tranferfunction.m)
%
%  Produces F_tire_model: modeled longitudinal drive force at the tires.
% =========================================================================

% raw engine signals (model was tuned on raw, unfiltered signals)
rpm          = data.engine_rpm;
throttle_raw = data.throttle_pct;
gear         = data.current_gear;

% Boost signals are not present in every log. When they are missing the
% engine-map boost blend cannot be evaluated, so the drive-force model
% falls back to the drivetrain-reported torque (est_drive_torque / Rw_r).
vn = data.Properties.VariableNames;
hasBoost = all(ismember({'boost_aim_kpa','boost_pressure_kpa'}, vn));

if hasBoost
    boost_aim      = data.boost_aim_kpa;
    boost_pressure = data.boost_pressure_kpa;
else
    boost_aim      = nan(size(t));
    boost_pressure = nan(size(t));
    warning('slip_force_with_model:noBoost', ...
        ['No boost_aim/boost_pressure in log; drive-force model uses ' ...
         'est_drive_torque / Rw_r instead of the engine map.']);
end

% Driveline ratios
diff_ratio = 3;
eff_diff   = 0.99;
gear_eff   = 0.91;
r_model    = 0.3;   % rolling radius used by the original model (keep for tau fit)

gear_ratio = zeros(size(gear));
gear_ratio(gear == 2) = 1.8667;
gear_ratio(gear ~= 2) = 2.9167;

total_ratio = eff_diff * diff_ratio * gear_ratio * gear_eff;

% ---- engine map look up ----

% boost map 30 psi  (columns: rpm, then throttle breakpoints 0.0 0.3 0.6 1.0)
map_boost_raw = readtable('engine_map_30psi.csv', ...
    'VariableNamingRule','preserve');

map_boost_throttle_bp = [0.0, 0.3, 0.6, 1.0];
map_boost_rpm_bp      = map_boost_raw{:, 1};
map_boost_torque      = map_boost_raw{:, 2:end};

valid_rows_boost      = isfinite(map_boost_rpm_bp);
map_boost_rpm_bp      = map_boost_rpm_bp(valid_rows_boost);
map_boost_torque      = map_boost_torque(valid_rows_boost, :);

% 0 percent boost / no boost map
map_noboost_raw = readtable('engine_map_no_boost.csv', ...
    'VariableNamingRule','preserve');

map_noboost_throttle_bp = [0.0, 0.5, 1.0];
map_noboost_rpm_bp      = map_noboost_raw{:, 1};
map_noboost_torque      = map_noboost_raw{:, 2:end};

valid_rows_noboost      = isfinite(map_noboost_rpm_bp);
map_noboost_rpm_bp      = map_noboost_rpm_bp(valid_rows_noboost);
map_noboost_torque      = map_noboost_torque(valid_rows_noboost, :);

% Clean throttle and rpm signals
throttle_norm  = throttle_raw / 100;
rpm_clean      = rpm;
throttle_clean = throttle_norm;

rpm_clean(~isfinite(rpm_clean)) = map_boost_rpm_bp(1);
throttle_clean(~isfinite(throttle_clean)) = 0;

% Clamp rpm and throttle separately for each map
rpm_clean_boost = min(max(rpm_clean, ...
    map_boost_rpm_bp(1)), map_boost_rpm_bp(end));

rpm_clean_noboost = min(max(rpm_clean, ...
    map_noboost_rpm_bp(1)), map_noboost_rpm_bp(end));

throttle_clean_boost = min(max(throttle_clean, ...
    map_boost_throttle_bp(1)), map_boost_throttle_bp(end));

throttle_clean_noboost = min(max(throttle_clean, ...
    map_noboost_throttle_bp(1)), map_noboost_throttle_bp(end));

% Interpolate each torque map independently
T_map_boost = interp2( ...
    map_boost_throttle_bp, map_boost_rpm_bp, map_boost_torque, ...
    throttle_clean_boost, rpm_clean_boost, 'linear');

T_map_noboost = interp2( ...
    map_noboost_throttle_bp, map_noboost_rpm_bp, map_noboost_torque, ...
    throttle_clean_noboost, rpm_clean_noboost, 'linear');

if hasBoost
    % Boost blend: alpha = boost_pressure / boost_aim, clamped to [0,1]
    alpha = zeros(size(t));

    boost_cmd_idx = boost_aim > 0 & isfinite(boost_aim) & isfinite(boost_pressure);
    alpha(boost_cmd_idx) = boost_pressure(boost_cmd_idx) ./ boost_aim(boost_cmd_idx);

    alpha(~isfinite(alpha)) = 0;
    alpha = min(max(alpha, 0), 1);

    % alpha method
    T_map = (1 - alpha) .* T_map_noboost + alpha .* T_map_boost;
    T_map(throttle_norm <= 0.06) = 0;
    tau = 0.153;   % seconds
    K = (T_map .* total_ratio) ./ r_model;

    t_lsim = t - t(1);

    A = -1/tau;  B =  1/tau;  C =  1;  D =  0;
    sys_first_order = ss(A, B, C, D);

    y0 = K(1);
    F_tire_model = data.est_drive_torque_nm ./ Rw_r;
else
    % No boost data: use drivetrain-reported drive torque directly
    if ~ismember('est_drive_torque_nm', vn)
        error('slip_force_with_model:noDriveTorque', ...
            'No boost data and no est_drive_torque_nm column; cannot model drive force.');
    end
    F_tire_model = data.est_drive_torque_nm ./ Rw_r;
end


%% 
%  CALIPER BRAKING FORCE MODEL  (breaking_force_calc_*)

A_caliper = 4486.0;
mue_k     = 0.4;
R_lever   = 0.134;

breaking_force_calc_front = - (Pf * (A_caliper * mue_k * R_lever)/1000) ./ Rw_f;
breaking_force_calc_rear  = - (Pr * (A_caliper * mue_k * R_lever)/1000) ./ Rw_r;

%%
%  MEASURED longitudinal force 


brakePressureTotal = Pf + Pr;

biasF = defaultFrontBrakeBias .* ones(size(Fx_total));

hasBrakePressure = brakePressureTotal > brakePressureMin_kPa;
biasF(hasBrakePressure) = Pf(hasBrakePressure) ./ brakePressureTotal(hasBrakePressure);

% Clamp for safety
biasF = max(0, min(1, biasF));

driveMode = Fx_total >  Fx_deadband_N;
brakeMode = Fx_total < -Fx_deadband_N;
coastMode = ~driveMode & ~brakeMode;

Fxf = zeros(size(Fx_total));
Fxr = zeros(size(Fx_total));

% Acceleration: rear axle only
Fxf(driveMode) = 0;
Fxr(driveMode) = Fx_total(driveMode);

% Braking: split by front brake bias
Fxf(brakeMode) = biasF(brakeMode) .* Fx_total(brakeMode);
Fxr(brakeMode) = (1 - biasF(brakeMode)) .* Fx_total(brakeMode);

% Coasting / deadband: both zero
Fxf(coastMode) = 0;
Fxr(coastMode) = 0;

% per tire (measured) -- assumption: Fx is split evenly between two tires
fx_fl = zeros(size(Fx_total));
fx_fr = zeros(size(Fx_total));
fx_rl = zeros(size(Fx_total));
fx_rr = zeros(size(Fx_total));

fx_rl(driveMode) = Fxr(driveMode)/2;
fx_rr(driveMode) = Fxr(driveMode)/2;
fx_fl(driveMode) = 0;
fx_fr(driveMode) = 0;

fx_rl(brakeMode) = Fxr(brakeMode)/2;
fx_rr(brakeMode) = Fxr(brakeMode)/2;
fx_fl(brakeMode) = Fxf(brakeMode)/2;
fx_fr(brakeMode) = Fxf(brakeMode)/2;

fx_rr(coastMode) = Fxr(coastMode);
fx_rl(coastMode) = Fxr(coastMode);
fx_fr(coastMode) = Fxf(coastMode);
fx_fl(coastMode) = Fxf(coastMode);

%% 
%  MODELED longitudinal force split



driveMode_m = isAccelerating;                       
brakeMode_m = hasBrakePressure & ~driveMode_m;     
coastMode_m = ~driveMode_m & ~brakeMode_m;

% per axle (modeled)
Fxf_model = zeros(size(Fx_total));
Fxr_model = zeros(size(Fx_total));

% braking: caliper model (per-tire value x2 => axle)
Fxf_model(brakeMode_m) = 2 .* breaking_force_calc_front(brakeMode_m);
Fxr_model(brakeMode_m) = 2 .* breaking_force_calc_rear(brakeMode_m);

% accelerating: engine map to rear axle only
Fxf_model(driveMode_m) = 0;
Fxr_model(driveMode_m) = F_tire_model(driveMode_m);

% per tire (modeled)
fx_fl_model = zeros(size(Fx_total));
fx_fr_model = zeros(size(Fx_total));
fx_rl_model = zeros(size(Fx_total));
fx_rr_model = zeros(size(Fx_total));

% braking: caliper model per tire
fx_fl_model(brakeMode_m) = breaking_force_calc_front(brakeMode_m);
fx_fr_model(brakeMode_m) = breaking_force_calc_front(brakeMode_m);
fx_rl_model(brakeMode_m) = breaking_force_calc_rear(brakeMode_m);
fx_rr_model(brakeMode_m) = breaking_force_calc_rear(brakeMode_m);

% accelerating: engine map split evenly between the two rear tires
fx_rl_model(driveMode_m) = F_tire_model(driveMode_m)/2;
fx_rr_model(driveMode_m) = F_tire_model(driveMode_m)/2;
fx_fl_model(driveMode_m) = 0;
fx_fr_model(driveMode_m) = 0;

% Rear-axle modeled Fx broken into its throttle and brake contributions so
% their sum can be compared against the measured rear-axle Fx.
Fxr_model_drive = zeros(size(Fx_total));   % engine-map drive force
Fxr_model_brake = zeros(size(Fx_total));   % caliper braking force

Fxr_model_drive(driveMode_m) = F_tire_model(driveMode_m);
Fxr_model_brake(brakeMode_m) = 2 .* breaking_force_calc_rear(brakeMode_m);

Fxr_model_combined = Fxr_model_drive + Fxr_model_brake;   % == Fxr_model

%%
%  Wheel Speeds
Vw_fl = movmean(data.fl_speed_kmh, mm) ./ 3.61 - 0.1;
Vw_fr = movmean(data.fr_speed_kmh, mm) ./ 3.61 - 0.1;
Vw_rl = movmean(data.rl_speed_kmh, mm) ./ 3.61 - 0.1;
Vw_rr = movmean(data.rr_speed_kmh, mm) ./ 3.61 - 0.1;

Vw_front = 0.5 .* (Vw_fl + Vw_fr);
Vw_rear  = 0.5 .* (Vw_rl + Vw_rr);

ft = front_track;   rt = rear_track;
Vx_fl_c = vx - r .* (ft/2);
Vx_fr_c = vx + r .* (ft/2);
Vx_rl_c = vx - r .* (rt/2);
Vx_rr_c = vx + r .* (rt/2);
Vy_front_c = vy + r .* lf;
Vy_rear_c  = vy - r .* lr;

Vx_tire_fl =  Vx_fl_c .* cos(delta) + Vy_front_c .* sin(delta);
Vx_tire_fr =  Vx_fr_c .* cos(delta) + Vy_front_c .* sin(delta);
Vx_tire_rl =  Vx_rl_c;
Vx_tire_rr =  Vx_rr_c;
Vy_tire_fl = -Vx_fl_c .* sin(delta) + Vy_front_c .* cos(delta);
Vy_tire_fr = -Vx_fr_c .* sin(delta) + Vy_front_c .* cos(delta);
Vy_tire_rl =  Vy_rear_c;
Vy_tire_rr =  Vy_rear_c;

mask = abs(vx) < vx_min_slip_ratio;
Vx_tire_fl(mask) = 0;  Vy_tire_fl(mask) = 0;
Vx_tire_fr(mask) = 0;  Vy_tire_fr(mask) = 0;
Vx_tire_rl(mask) = 0;  Vy_tire_rl(mask) = 0;
Vx_tire_rr(mask) = 0;  Vy_tire_rr(mask) = 0;

%  Slip Ratios (per tire)
slip_ratio_x_fl = (Vw_fl - Vx_tire_fl) ./ Vw_fl;
slip_ratio_x_fr = (Vw_fr - Vx_tire_fr) ./ Vw_fr;
slip_ratio_x_rl = (Vw_rl - Vx_tire_rl) ./ Vw_rl;
slip_ratio_x_rr = (Vw_rr - Vx_tire_rr) ./ Vw_rr;

%%
% per axle slip ratio

Vx_front_axle = vx;
Vy_front_axle = vy + r .* lf;

Vx_rear_axle  = vx;
Vy_rear_axle  = vy - r .* lr;
slip_ratio_f = (Vw_front - Vx_front_axle) ./ Vw_front;
slip_ratio_r = (Vw_rear  - Vx_rear_axle)  ./ Vw_rear;

%%
%  Valid Plot Masks (axle)

validFront = isfinite(alpha_f_deg) & isfinite(Fyf) & ...
             isfinite(slip_ratio_f) & ...
             isfinite(ds) & ...
             abs(vx) > vx_min_slip_angle & ...
             abs(alpha_f_deg) < 20 & ...
             abs(slip_ratio_f) < 1.0 & ...
             accelKeep;

validRear = isfinite(alpha_r_deg) & isfinite(Fyr) & ...
            isfinite(slip_ratio_r) & ...
            isfinite(ds) & ...
            abs(vx) > vx_min_slip_angle & ...
            abs(alpha_r_deg) < 20 & ...
            abs(slip_ratio_r) < 1.0 & ...
            accelKeep;

%  Valid Plot Masks (per tire) -- based on slip + speed so they can be
%  reused for both measured and modeled Fx.
validTire = @(sr) isfinite(sr) & isfinite(ds) & ...
                  abs(vx) > vx_min_slip_angle & abs(sr) < 1.0 & accelKeep;

validFL = validTire(slip_ratio_x_fl);
validFR = validTire(slip_ratio_x_fr);
validRL = validTire(slip_ratio_x_rl);
validRR = validTire(slip_ratio_x_rr);

%% =========================================================================
%  FIGURE 1: slip angle vs Fy  (front and rear axle, measured Fy)
% =========================================================================
figure('Name','Fig 1 - Slip Angle vs Fy (per axle)');

subplot(1,2,1)
scatter(alpha_f_deg(validFront), Fyf(validFront), 18, t(validFront), 'filled');
grid on;
xlabel('Front slip angle \alpha_f [deg]');
ylabel('Front lateral force F_{y,f} [N]');
title('Front F_y vs Slip Angle');
cb = colorbar; ylabel(cb, 'Time [s]');
xline(0,'k--'); yline(0,'k--');

subplot(1,2,2)
scatter(alpha_r_deg(validRear), Fyr(validRear), 18, t(validRear), 'filled');
grid on;
xlabel('Rear slip angle \alpha_r [deg]');
ylabel('Rear lateral force F_{y,r} [N]');
title('Rear F_y vs Slip Angle');
cb = colorbar; ylabel(cb, 'Time [s]');
xline(0,'k--'); yline(0,'k--');

sgtitle('Figure 1: Lateral Force vs Slip Angle (per axle)');

%% =========================================================================
%  FIGURE 2: slip ratio vs Fx  (per axle, MEASURED Fx)
% =========================================================================
figure('Name','Fig 2 - Slip Ratio vs Fx (per axle, measured)');

subplot(1,2,1)
scatter(slip_ratio_f(validFront), Fxf(validFront), 18, t(validFront), 'filled');
grid on;
xlabel('Front slip ratio \kappa_f [-]');
ylabel('Front longitudinal force F_{x,f} [N]');
title('Front F_x vs Slip Ratio (measured)');
cb = colorbar; ylabel(cb, 'Time [s]');
xline(0,'k--'); yline(0,'k--');

subplot(1,2,2)
scatter(slip_ratio_r(validRear), Fxr(validRear), 18, t(validRear), 'filled');
grid on;
xlabel('Rear slip ratio \kappa_r [-]');
ylabel('Rear longitudinal force F_{x,r} [N]');
title('Rear F_x vs Slip Ratio (measured)');
cb = colorbar; ylabel(cb, 'Time [s]');
xline(0,'k--'); yline(0,'k--');

sgtitle('Figure 2: Longitudinal Force vs Slip Ratio (per axle, measured F_x)');

%% =========================================================================
%  FIGURE 3: slip ratio vs Fx  (per axle, MODELED Fx: brake + engine map)
% =========================================================================
figure('Name','Fig 3 - Slip Ratio vs Fx (per axle, modeled)');

subplot(1,2,1)
scatter(slip_ratio_f(validFront), Fxf_model(validFront), 18, t(validFront), 'filled');
grid on;
xlabel('Front slip ratio \kappa_f [-]');
ylabel('Front longitudinal force F_{x,f} [N]');
title('Front F_x vs Slip Ratio (modeled)');
cb = colorbar; ylabel(cb, 'Time [s]');
xline(0,'k--'); yline(0,'k--');

subplot(1,2,2)
scatter(slip_ratio_r(validRear), Fxr_model(validRear), 18, t(validRear), 'filled');
grid on;
xlabel('Rear slip ratio \kappa_r [-]');
ylabel('Rear longitudinal force F_{x,r} [N]');
title('Rear F_x vs Slip Ratio (modeled)');
cb = colorbar; ylabel(cb, 'Time [s]');
xline(0,'k--'); yline(0,'k--');

sgtitle('Figure 3: Longitudinal Force vs Slip Ratio (per axle, modeled F_x)');

%% =========================================================================
%  FIGURE 4: slip ratio vs Fx  (per tire, MEASURED Fx)
% =========================================================================
figure('Name','Fig 4 - Slip Ratio vs Fx (per tire, measured)');

subplot(2,2,1)
scatter(slip_ratio_x_fl(validFL), fx_fl(validFL), 18, t(validFL), 'filled');
grid on; xlabel('\kappa_{fl} [-]'); ylabel('F_{x,fl} [N]');
title('Front Left (measured)');
cb = colorbar; ylabel(cb,'Time [s]'); xline(0,'k--'); yline(0,'k--');

subplot(2,2,2)
scatter(slip_ratio_x_fr(validFR), fx_fr(validFR), 18, t(validFR), 'filled');
grid on; xlabel('\kappa_{fr} [-]'); ylabel('F_{x,fr} [N]');
title('Front Right (measured)');
cb = colorbar; ylabel(cb,'Time [s]'); xline(0,'k--'); yline(0,'k--');

subplot(2,2,3)
scatter(slip_ratio_x_rl(validRL), fx_rl(validRL), 18, t(validRL), 'filled');
grid on; xlabel('\kappa_{rl} [-]'); ylabel('F_{x,rl} [N]');
title('Rear Left (measured)');
cb = colorbar; ylabel(cb,'Time [s]'); xline(0,'k--'); yline(0,'k--');

subplot(2,2,4)
scatter(slip_ratio_x_rr(validRR), fx_rr(validRR), 18, t(validRR), 'filled');
grid on; xlabel('\kappa_{rr} [-]'); ylabel('F_{x,rr} [N]');
title('Rear Right (measured)');
cb = colorbar; ylabel(cb,'Time [s]'); xline(0,'k--'); yline(0,'k--');

sgtitle('Figure 4: Longitudinal Force vs Slip Ratio (per tire, measured F_x)');

%% =========================================================================
