sgtitle('Figure 7: Friction Circle F_x vs F_y (per axle, modeled F_x)');

%% 
% combined slip


Vw_min_paper = 5;      
Fz_min_paper = 200;    

% Slip denominators (blank out low wheel speeds)
den_fl = Vw_fl;  den_fl(abs(den_fl) < Vw_min_paper) = NaN;
den_fr = Vw_fr;  den_fr(abs(den_fr) < Vw_min_paper) = NaN;
den_rl = Vw_rl;  den_rl(abs(den_rl) < Vw_min_paper) = NaN;
den_rr = Vw_rr;  den_rr(abs(den_rr) < Vw_min_paper) = NaN;

% Total slip per tire
S_fl = hypot((Vx_tire_fl - Vw_fl) ./ den_fl, Vy_tire_fl ./ den_fl);
S_fr = hypot((Vx_tire_fr - Vw_fr) ./ den_fr, Vy_tire_fr ./ den_fr);
S_rl = hypot((Vx_tire_rl - Vw_rl) ./ den_rl, Vy_tire_rl ./ den_rl);
S_rr = hypot((Vx_tire_rr - Vw_rr) ./ den_rr, Vy_tire_rr ./ den_rr);

% Effective per-tire normal loads (share the axle offset between the two tires)
Fz_fl_eff = Fz_fl + 0.5 * Fz_front_offset_N;
Fz_fr_eff = Fz_fr + 0.5 * Fz_front_offset_N;
Fz_rl_eff = Fz_rl + 0.5 * Fz_rear_offset_N;
Fz_rr_eff = Fz_rr + 0.5 * Fz_rear_offset_N;

% --- FIGURE 8: paper method with MEASURED Fx ---
figure('Name','Fig 8 - Paper Method (measured Fx)');

subplot(2,2,1)
plotPaper(S_fl, hypot(fx_fl, Fyf./2), Fz_fl_eff, t, vx, ...
    'FL (measured)', Fz_min_paper, vx_min_slip_angle);
subplot(2,2,2)
plotPaper(S_fr, hypot(fx_fr, Fyf./2), Fz_fr_eff, t, vx, ...
    'FR (measured)', Fz_min_paper, vx_min_slip_angle);
subplot(2,2,3)
plotPaper(S_rl, hypot(fx_rl, Fyr./2), Fz_rl_eff, t, vx, ...
    'RL (measured)', Fz_min_paper, vx_min_slip_angle);
subplot(2,2,4)
plotPaper(S_rr, hypot(fx_rr, Fyr./2), Fz_rr_eff, t, vx, ...
    'RR (measured)', Fz_min_paper, vx_min_slip_angle);

sgtitle('Figure 8: Paper Method F_n vs S (measured F_x)');

% --- FIGURE 9: paper method with MODELED Fx ---
figure('Name','Fig 9 - Paper Method (modeled Fx)');

subplot(2,2,1)
plotPaper(S_fl, hypot(fx_fl_model, Fyf./2), Fz_fl_eff, t, vx, ...
    'FL (modeled)', Fz_min_paper, vx_min_slip_angle);
subplot(2,2,2)
plotPaper(S_fr, hypot(fx_fr_model, Fyf./2), Fz_fr_eff, t, vx, ...
    'FR (modeled)', Fz_min_paper, vx_min_slip_angle);
subplot(2,2,3)
plotPaper(S_rl, hypot(fx_rl_model, Fyr./2), Fz_rl_eff, t, vx, ...
    'RL (modeled)', Fz_min_paper, vx_min_slip_angle);
subplot(2,2,4)
plotPaper(S_rr, hypot(fx_rr_model, Fyr./2), Fz_rr_eff, t, vx, ...
    'RR (modeled)', Fz_min_paper, vx_min_slip_angle);

sgtitle('Figure 9: Paper Method F_n vs S (modeled F_x)');

%% =========================================================================
%  FIGURE 10: rear-axle Fx, measured vs modeled (throttle + brake) over time

figure('Name','Fig 10 - Rear Axle Fx: measured vs modeled');

ax10 = gobjects(3,1);

ax10(1) = subplot(4,1,1);
plot(t, Fxr, 'b', 'LineWidth', 1.5, 'DisplayName', 'F_{x,r} measured');
hold on;
plot(t, Fxr_model_combined, 'r', 'LineWidth', 1.5, ...
    'DisplayName', 'F_{x,r} modeled (throttle + brake)');
plot(t, Fxr_model_drive, 'g--', 'LineWidth', 1.0, ...
    'DisplayName', 'modeled throttle (engine map)');
plot(t, Fxr_model_brake, 'm--', 'LineWidth', 1.0, ...
    'DisplayName', 'modeled brake (caliper)');
grid on;
xlabel('Time [s]');
ylabel('F_{x,r} [N]');
title('Rear Axle F_x: Measured vs Modeled (Throttle + Brake)');
legend('Location', 'best');
yline(0, 'k--', 'HandleVisibility', 'off');

ax10(2) = subplot(4,1,2);
plot(t, Vx_tire_rl, 'b', 'LineWidth', 1.5, 'DisplayName', 'V_{x} rear-left tire');
hold on;
plot(t, Vw_rl, 'r', 'LineWidth', 1.5, 'DisplayName', 'wheel speed rear-left');
grid on;
xlabel('Time [s]');
ylabel('Speed [m/s]');
title('Rear-Right Tire: Contact-Point V_x vs Wheel Speed');
legend('Location', 'best');

ax10(3) = subplot(4,1,3);
plot(t, slip_ratio_x_rl, 'k', 'LineWidth', 1.5);
grid on;
xlabel('Time [s]');
ylabel('slip ratio rear left');


ax10(4) = subplot(4,1,4);
plot(t,throttle_pct)
xlabel('time [s]')
ylabel('throttle')
linkaxes(ax10, 'x');

%% =========================================================================
%  Local Functions
% =========================================================================
function plotPaper(S, F, Fz_eff, tv, vx, ttl, Fz_min, vx_min)
    Fn = F ./ Fz_eff;
    v = isfinite(S) & isfinite(Fn) & Fz_eff > Fz_min & abs(vx) > vx_min & ...
        S >= 0 & S < 0.6 & Fn >= 0 & Fn < 2.0;
    scatter(S(v), Fn(v), 12, tv(v), 'filled');
    grid on;
    xlabel('Total slip S [-]');
    ylabel('F_n = |F| / F_z [-]');
    title(ttl);
    cb = colorbar; ylabel(cb, 'Time [s]');
end
