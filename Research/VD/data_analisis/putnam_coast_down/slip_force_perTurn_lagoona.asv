clc
close all
clear

%% opening csv

% data = readtable('FastLaps.csv');
% data = readtable('/home/elijah/PurdueRacing/bags/putnam/oversteer/2026-04-28_150159_merged.csv');
data = readtable('/home/elijah/PurdueRacing/bags/lagoona/comp/csv_output/2025-07-24_175839_merged.csv');
% data = readtable('/home/elijah/bag_files/VD/laguna/comp/2025-07-24_175839_merged.csv');

%% filtered data

mm = 20;

Ft = movmean(data.time_s, mm);

Fax = movmean(data.a_x, mm);
Fay = movmean(data.a_y, mm);
Faz = movmean(data.a_z, mm);

Ffz_fr = movmean(data.fr_load_n, mm);
Ffz_fl = movmean(data.fl_load_n, mm);
Ffz_rr = movmean(data.rr_load_n, mm);
Ffz_rl = movmean(data.rl_load_n, mm);

Fvx = movmean(data.odom_vx_mps, mm);
Fvy = movmean(data.odom_vy_mps, mm);

Frpm = movmean(data.engine_rpm, mm);
throttle = data.throttle_pct;
Fgear = movmean(data.current_gear, mm);
FT_e = movmean(data.est_drive_torque_nm, mm);
Fbrake = movmean(data.front_brake_pressure_kpa, mm);

steering_wheel = movmean(data.steer_wheel_ang_deg, mm);

toe_angle = 0.333 + steering_wheel ./ 15.015;
toe_rad = deg2rad(toe_angle);

Fqx = movmean(data.odom_qx, mm);
Fqy = movmean(data.odom_qy, mm);
Fqz = movmean(data.odom_qz, mm);
Fqw = movmean(data.odom_qw, mm);

Fwz = movmean(data.odom_wz_rads, mm);
Fwx = movmean(data.odom_wx_rads, mm);
Fwy = movmean(data.odom_wy_rads, mm);

x_pos = data.odom_px_m;
y_pos = data.odom_py_m;

%% tire temperature

fr_T_0 = data.fr_temp_1;
fr_T_1 = data.fr_temp_2;
fr_T_2 = data.fr_temp_3;
fr_T_3 = data.fr_temp_4;

%% quaternion to yaw, pitch, roll

Fq = [Fqw Fqx Fqy Fqz];

Feul = quat2eul(Fq, 'ZYX');   % [yaw pitch roll]

Fyaw   = Feul(:,1);
Fpitch = Feul(:,2);
Froll  = Feul(:,3);

yaw_u   = unwrap(Fyaw);
pitch_u = unwrap(Fpitch);
roll_u  = unwrap(Froll);

yaw_dot   = Fwz;
pitch_dot = Fwy;
roll_dot  = Fwx;

%% time, velocity, distance

t = data.time_s(:);
t = t - t(1);

V = sqrt(Fvx.^2 + Fvy.^2);

ds = [0; cumsum(0.5 .* (V(1:end-1) + V(2:end)) .* diff(t))];

%% curvature from yaw, pitch, and roll rate

v_min_curv = 2.0;

kappa_yaw   = nan(size(V));
kappa_pitch = nan(size(V));
kappa_roll  = nan(size(V));

curv_valid = isfinite(V) & V > v_min_curv;

kappa_yaw(curv_valid)   = yaw_dot(curv_valid)   ./ V(curv_valid);
kappa_pitch(curv_valid) = pitch_dot(curv_valid) ./ V(curv_valid);
kappa_roll(curv_valid)  = roll_dot(curv_valid)  ./ V(curv_valid);

%% vehicle parameters

vehicleParams.wheelbase   = 2.9718;   % wheelbase [m]
vehicleParams.w_dist_f    = 0.42;     % front weight distribution
vehicleParams.m           = 787;      % mass [kg]
vehicleParams.frontalArea = 1;        % frontal area [m^2]
vehicleParams.inertia     = 1000;     % yaw inertia [kg m^2]

L  = vehicleParams.wheelbase;
b  = vehicleParams.w_dist_f * L;
a  = L - b;

m  = vehicleParams.m;
Iz = vehicleParams.inertia;

g = 9.81;

%% yaw acceleration

r = Fwz;

rdot = gradient(r, t);
rdot = movmean(rdot, mm);

%% lateral acceleration method

theta = -Fpitch;
phi   = Froll;

v_min_curv = 5.0;

v2_kappa_yaw   = V.^2 .* kappa_yaw;
v2_kappa_pitch = V.^2 .* kappa_pitch;
v2_kappa_roll  = V.^2 .* kappa_roll;

curv_valid = isfinite(V) & V > v_min_curv & ...
             isfinite(kappa_yaw) & ...
             isfinite(theta) & ...
             isfinite(phi);

v2_kappa_yaw(~curv_valid)   = nan;
v2_kappa_pitch(~curv_valid) = nan;
v2_kappa_roll(~curv_valid)  = nan;

% lateral acceleration from yaw curvature
ay_inertial = v2_kappa_yaw;

% gravity projected into lateral body axis from roll/bank
g_y_body = -g .* cos(theta) .* sin(phi);

% Set true if you want to include bank/roll gravity correction.
useBankRollGravity = false;

if useBankRollGravity
    ay_tire = ay_inertial - g_y_body;
else
    ay_tire = ay_inertial;
end

%% front/rear bicycle lateral force split

Fyf = (b .* m .* ay_tire + Iz .* rdot) ./ L;
Fyr = (a .* m .* ay_tire - Iz .* rdot) ./ L;

%% slip angle calculation

delta = toe_rad;

vx_min = 10.0;

vx_safe = Fvx;
vx_safe(abs(vx_safe) < vx_min) = nan;

alpha_f = delta - atan2(Fvy + a .* r, vx_safe);
alpha_r =       - atan2(Fvy - b .* r, vx_safe);

alpha_f_deg = rad2deg(alpha_f);
alpha_r_deg = rad2deg(alpha_r);

%% valid mask

valid = isfinite(alpha_f_deg) & ...
        isfinite(alpha_r_deg) & ...
        isfinite(Fyf) & ...
        isfinite(Fyr) & ...
        isfinite(x_pos) & ...
        isfinite(y_pos) & ...
        abs(Fvx) > vx_min;

%% connected polygon section setup
% These are the ordered shared transition points around the track.
% Each point is treated as the center of a gate/border line.
% Section 1 goes from gate 1 to gate 2.
% Section 2 goes from gate 2 to gate 3.
% ...
% Last section goes from final gate back to gate 1.

gate_x = [-106.1; -115.4; 18.39; 172; 367.59; 577; 536.6; 377.25];
gate_y = [-128; -460; -279.28; -539.9; -800; -586; -192.4; 639.76];

gateCenters = [gate_x, gate_y];

numGates = size(gateCenters, 1);
numCorners = numGates;

% Rename these however you want.
sectionNames = strings(numCorners, 1);
for i = 1:numCorners
    sectionNames(i) = "S" + string(i);
end

% This controls how wide each shared border line is.
% Increase if polygons do not cover the blue track.
% Decrease if polygons touch another part of the track.
gateHalfWidth = 90;   % [m]

%% create shared gate border lines

gateLeft  = zeros(numGates, 2);
gateRight = zeros(numGates, 2);

for i = 1:numGates

    if i == 1
        pPrev = gateCenters(end, :);
        pNext = gateCenters(i+1, :);
    elseif i == numGates
        pPrev = gateCenters(i-1, :);
        pNext = gateCenters(1, :);
    else
        pPrev = gateCenters(i-1, :);
        pNext = gateCenters(i+1, :);
    end

    tangent = pNext - pPrev;
    tangent = tangent ./ norm(tangent);

    normal = [-tangent(2), tangent(1)];

    gateLeft(i, :)  = gateCenters(i, :) + gateHalfWidth .* normal;
    gateRight(i, :) = gateCenters(i, :) - gateHalfWidth .* normal;

end

%% build connected polygons
% Adjacent polygons share the exact same border points.

cornerPolys = cell(numCorners, 2);

for i = 1:numCorners

    iNext = i + 1;

    if iNext > numGates
        iNext = 1;
    end

    P = [
        gateLeft(i, :);
        gateLeft(iNext, :);
        gateRight(iNext, :);
        gateRight(i, :)
    ];

    cornerPolys{i, 1} = sectionNames(i);
    cornerPolys{i, 2} = P;

end

%% create corner masks using polygon method
% inpolygon includes boundary points.
% To prevent a boundary point from being counted in two sections,
% this assigns each data point to only the first section it appears in.

cornerMasks = false(length(x_pos), numCorners);
alreadyAssigned = false(length(x_pos), 1);

rawCornerMasks = false(length(x_pos), numCorners);

for i = 1:numCorners

    P = cornerPolys{i, 2};

    poly_x = P(:,1);
    poly_y = P(:,2);

    insideCorner = inpolygon(x_pos, y_pos, poly_x, poly_y);

    rawCornerMasks(:, i) = insideCorner & valid;

    cornerMasks(:, i) = insideCorner & valid & ~alreadyAssigned;

    alreadyAssigned = alreadyAssigned | cornerMasks(:, i);

end

%% overlap diagnostic

numRawMatches = sum(rawCornerMasks, 2);
overlapMask = numRawMatches > 1;
unassignedValidMask = valid & ~any(cornerMasks, 2);

fprintf("\nPolygon section diagnostic:\n")
fprintf("Valid points:              %d\n", nnz(valid))
fprintf("Assigned valid points:     %d\n", nnz(any(cornerMasks, 2)))
fprintf("Unassigned valid points:   %d\n", nnz(unassignedValidMask))
fprintf("Raw overlapping points:    %d\n", nnz(overlapMask))
fprintf("\n")

for i = 1:numCorners
    fprintf("%s points: %d\n", cornerPolys{i,1}, nnz(cornerMasks(:,i)))
end

%% plot track with connected polygon sections

figure
plot(x_pos, y_pos, 'b', 'LineWidth', 1.2)
hold on
grid on
axis equal
xlabel("xpos")
ylabel("ypos")
title("Track Map with Connected Polygon Sections")

% Plot gate center points
plot(gate_x, gate_y, 'ko', ...
    'MarkerFaceColor', 'k', ...
    'MarkerSize', 5)

% Plot polygons
for i = 1:numCorners

    name = cornerPolys{i, 1};
    P = cornerPolys{i, 2};

    poly_x = P(:,1);
    poly_y = P(:,2);

    patch(poly_x, poly_y, 'r', ...
        'FaceColor', 'none', ...
        'EdgeColor', 'r', ...
        'LineWidth', 1.5);

    text(mean(poly_x), mean(poly_y), name, ...
        'Color', 'r', ...
        'FontSize', 9, ...
        'FontWeight', 'bold', ...
        'HorizontalAlignment', 'center', ...
        'Interpreter', 'none');

end

% Plot shared gate borders
for i = 1:numGates

    plot([gateLeft(i,1), gateRight(i,1)], ...
         [gateLeft(i,2), gateRight(i,2)], ...
         'k--', ...
         'LineWidth', 1.2)

    text(gateCenters(i,1), gateCenters(i,2), ...
        "G" + string(i), ...
        'Color', 'k', ...
        'FontSize', 8, ...
        'FontWeight', 'bold', ...
        'HorizontalAlignment', 'center');

end

% Plot unassigned valid points, if any
if any(unassignedValidMask)
    plot(x_pos(unassignedValidMask), y_pos(unassignedValidMask), ...
        'mo', ...
        'MarkerSize', 3)
end

legend("track", "gate centers", "sections", "gate borders", "unassigned valid points")

%% optional diagnostic plots

figure
tiledlayout(4,1)

nexttile
plot(t, ay_inertial)
grid on
ylabel("a_{y,inertial} [m/s^2]")
title("Lateral Acceleration from Yaw Curvature")

nexttile
plot(t, g_y_body)
grid on
ylabel("g_y body [m/s^2]")
title("Gravity Lateral Component from Bank/Roll")

nexttile
plot(t, ay_tire)
grid on
ylabel("a_{y,tire} [m/s^2]")
title("Tire Lateral Acceleration Demand")

nexttile
plot(t, Fay)
hold on
plot(t, ay_tire)
grid on
xlabel("time [s]")
ylabel("a_y [m/s^2]")
legend("IMU ay", "curvature method")
title("IMU vs Curvature-Based Tire Lateral Acceleration")

%% lateral force vs slip angle per section

nCols = 3;
nRows = ceil(numCorners / nCols);

figure
tl = tiledlayout(nRows, nCols, ...
    'TileSpacing', 'compact', ...
    'Padding', 'compact');

% Time normalization
tValid = Ft(valid & isfinite(Ft));

tMin = min(tValid);
tMax = max(tValid);

if tMax == tMin
    tMax = tMin + 1;
end

frontMap = winter(256);
rearMap  = autumn(256);

tNorm = (Ft - tMin) ./ (tMax - tMin);
tNorm = max(0, min(1, tNorm));

tIdx = round(1 + tNorm * 255);
tIdx(~isfinite(tIdx)) = 1;

frontColors = frontMap(tIdx, :);
rearColors  = rearMap(tIdx, :);

for i = 1:numCorners

    nexttile

    mask = cornerMasks(:, i);

    hold on

    scatter(alpha_f_deg(mask), Fyf(mask), ...
        14, frontColors(mask,:), ...
        'o', 'filled', ...
        'MarkerFaceAlpha', 0.75, ...
        'MarkerEdgeAlpha', 0.15)

    scatter(alpha_r_deg(mask), Fyr(mask), ...
        14, rearColors(mask,:), ...
        's', 'filled', ...
        'MarkerFaceAlpha', 0.75, ...
        'MarkerEdgeAlpha', 0.15)

    grid on
    xlabel("\alpha [deg]")
    ylabel("F_y [N]")
    title(cornerPolys{i,1}, 'Interpreter', 'none')

    hF = scatter(nan, nan, 40, [0 0.45 1], 'o', 'filled', ...
        'DisplayName', 'Front');

    hR = scatter(nan, nan, 40, [1 0.25 0], 's', 'filled', ...
        'DisplayName', 'Rear');

    legend([hF hR], 'Location', 'best')

end

title(tl, "Front and Rear Lateral Force vs Slip Angle by Track Section")