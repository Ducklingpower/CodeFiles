axAlN = gobjects(4,1);

for i = 1:4
    axAlN(i) = nexttile(tl);
    hold on
    plot(alpha_all(:,i), Fy_fz_all(:,i) ./ Fz_norm(:,i), ".", "Color", cFz);
    plot(alpha_all(:,i), Fy_fc_all(:,i) ./ Fz_norm(:,i), ".", "Color", cFc);
    plot(alpha_all(:,i), Fy_mf_all(:,i) ./ Fz_norm(:,i), ".", "Color", cMf);
