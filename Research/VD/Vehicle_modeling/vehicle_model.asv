axFc = gobjects(4,1);

for i = 1:4
    axFc(i) = nexttile(tl);
    hold on
    plot(t, Fy_fz_all(:,i), "Color", cFz);
    plot(t, Fy_fc_all(:,i), "Color", cFc);
    plot(t, Fy_mf_all(:,i), "Color", cMf);
    grid on
