%% plots slip ratio vs Fx per tire, wheel dynamics vs force balance

sxNames = ["FL", "FR", "RL", "RR"];
sx_all  = [sx_fl,    sx_fr,    sx_rl,    sx_rr   ];
Fx_wd4  = [Fx_fl,    Fx_fr,    Fx_rl,    Fx_rr   ];
