%% plots normalized slip curves, Fx/Fz and Fy/Fz (observed Fz)
% ASSUMPTION: tires under 200 N observed load are left out (lifted, ratio blows up)

Fz_norm = Fz_dual_obs;
Fz_norm(Fz_norm < 200) = NaN;

